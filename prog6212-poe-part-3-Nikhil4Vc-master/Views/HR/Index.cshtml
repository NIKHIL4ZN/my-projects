@{
    ViewData["Title"] = "HR Dashboard";
}
@using Microsoft.AspNetCore.Http
@if (Context.Session.GetString("UserEmail") == null)
{
    <script>
        window.location.href = '/Identity/Account/Login';
    </script>
}


<h2>HR Dashboard</h2>

<p class="text-muted">Welcome HR, please select an action:</p>

<div class="list-group">
    <a class="list-group-item list-group-item-action" asp-controller="HR" asp-action="ManageLecturers">
        Manage Lecturer Accounts
    </a>

    <a class="list-group-item list-group-item-action" asp-controller="HR" asp-action="SetRates">
        Set Lecturer Claim Rate
    </a>

    <a class="list-group-item list-group-item-action" asp-controller="HR" asp-action="Reports">
        Generate Claims Reports
    </a>

    <a class="list-group-item list-group-item-action" asp-controller="Home" asp-action="Index">
        Back to Main Menu
    </a>
</div>
