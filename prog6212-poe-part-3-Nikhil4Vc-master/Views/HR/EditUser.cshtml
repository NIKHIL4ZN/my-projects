@model MonthlyClaims_System.Models.EditUserViewModel
@using Microsoft.AspNetCore.Http
@if (Context.Session.GetString("UserEmail") == null)
{
    <script>
        window.location.href = '/Identity/Account/Login';
    </script>
}

<!--HR view to edit users account information-->

<h2>Edit User</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post">

    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Role</label>
        <select asp-for="SelectedRole" class="form-control">
            @foreach (var role in ViewBag.Roles as List<string>)
            {
                <option value="@role" selected="@(role == Model.SelectedRole)">
                    @role
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a asp-action="ManageUsers" class="btn btn-secondary">Cancel</a>
</form>
