@SmartX.Api_HostAddress = http://localhost:5229

### Register an environmental sensor

POST {{SmartX.Api_HostAddress}}/api/sensors
Content-Type: application/json

{
  "name": "Greenhouse Moisture Sensor A",
  "macAddress": "A4:CF:12:9B:20:01",
  "deploymentLocation": "Hydroponics Facility / Zone 1 / Bed A",
  "category": 1,
  "dataType": 1
}

### Get all registered sensors

GET {{SmartX.Api_HostAddress}}/api/sensors
Accept: application/json

### Test duplicate MAC-address protection

POST {{SmartX.Api_HostAddress}}/api/sensors
Content-Type: application/json

{
  "name": "Duplicate Moisture Sensor",
  "macAddress": "A4:CF:12:9B:20:01",
  "deploymentLocation": "Hydroponics Facility / Zone 2",
  "category": 1,
  "dataType": 1
}

### Test invalid MAC-address validation

POST {{SmartX.Api_HostAddress}}/api/sensors
Content-Type: application/json

{
  "name": "Invalid Sensor",
  "macAddress": "NOT-A-MAC",
  "deploymentLocation": "Utility Room",
  "category": 2,
  "dataType": 2
}

### Ingest floating-point moisture telemetry

POST {{SmartX.Api_HostAddress}}/api/telemetry/float
Content-Type: application/json

{
  "sensorId": "dfddd6d1-cc89-47c7-9785-9db4009c6085",
  "value": 42.7,
  "unit": "%",
  "sequenceNumber": 1
}

### Test duplicate packet prevention

POST {{SmartX.Api_HostAddress}}/api/telemetry/float
Content-Type: application/json

{
  "sensorId": "dfddd6d1-cc89-47c7-9785-9db4009c6085",
  "value": 43.1,
  "unit": "%",
  "sequenceNumber": 1
}

### Test incorrect payload type

POST {{SmartX.Api_HostAddress}}/api/telemetry/integer
Content-Type: application/json

{
  "sensorId": "dfddd6d1-cc89-47c7-9785-9db4009c6085",
  "value": 850,
  "unit": "W",
  "sequenceNumber": 2
}

 ### Retrieve sensor telemetry history

GET {{SmartX.Api_HostAddress}}/api/telemetry/sensor/dfddd6d1-cc89-47c7-9785-9db4009c6085?limit=100
Accept: application/json

  ### Ingest jagged-array moisture telemetry batches

POST {{SmartX.Api_HostAddress}}/api/telemetry/float/batch
Content-Type: application/json

{
  "sensorId": "dfddd6d1-cc89-47c7-9785-9db4009c6085",
  "batches": [
    [42.5, 42.1, 41.8],
    [41.4, 40.9],
    [40.6, 40.2, 39.8]
  ],
  "unit": "%",
  "startingSequenceNumber": 2,
  "intervalSeconds": 5
}

### Retrieve the updated telemetry history

GET {{SmartX.Api_HostAddress}}/api/telemetry/sensor/dfddd6d1-cc89-47c7-9785-9db4009c6085?limit=20
Accept: application/json

  ### Validate a safe recursive deployment tree

POST {{SmartX.Api_HostAddress}}/api/deployments/validate
Content-Type: application/json

{
  "name": "Durban Hydroponics Facility",
  "nodeType": 1,
  "children": [
    {
      "name": "Growing Zone 1",
      "nodeType": 2,
      "children": [
        {
          "name": "Sub-Zone B",
          "nodeType": 3,
          "children": [
            {
              "name": "ESP32 Gateway 1",
              "nodeType": 4,
              "children": [
                {
                  "name": "Moisture Sensor A",
                  "nodeType": 5,
                  "sensorMacAddress": "A4:CF:12:9B:20:01",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

        ### Reject an unsafe recursive deployment tree

POST {{SmartX.Api_HostAddress}}/api/deployments/validate
Content-Type: application/json

{
  "name": "Durban Hydroponics Facility",
  "nodeType": 1,
  "children": [
    {
      "name": "Unsafe Sensor",
      "nodeType": 5,
      "sensorMacAddress": "INVALID-MAC",
      "children": [
        {
          "name": "Nested Sensor",
          "nodeType": 5,
          "sensorMacAddress": "11:22:33:44:55:66",
          "children": []
        }
      ]
    }
  ]
}

        ### Upload an encrypted ESP32 configuration file

POST {{SmartX.Api_HostAddress}}/api/sensors/dfddd6d1-cc89-47c7-9785-9db4009c6085/attachments
Content-Type: multipart/form-data; boundary=SmartXBoundary

--SmartXBoundary
Content-Disposition: form-data; name="file"; filename="esp32-moisture-config.json"
Content-Type: application/json

{
  "deviceModel": "ESP32-WROOM-32",
  "sampleIntervalSeconds": 5,
  "moistureThresholdPercent": 20,
  "gatewayNode": "ESP32 Gateway 1",
  "firmwareVersion": "1.0.0"
}
--SmartXBoundary--

