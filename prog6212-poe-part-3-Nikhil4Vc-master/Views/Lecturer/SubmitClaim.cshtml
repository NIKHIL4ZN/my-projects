@model MonthlyClaims_System.Models.Claim
@using Microsoft.AspNetCore.Http
@if (Context.Session.GetString("UserEmail") == null)
{
    <script>
        window.location.href = '/Identity/Account/Login';
    </script>
}


@{
    ViewData["Title"] = "Submit Claim";
}

<!--Lecturer view to submit claims-->

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <div class="btn-group" role="group">
        <a asp-controller="Lecturer" asp-action="SubmitClaim" class="btn btn-primary">Submit New Claim</a>
        <a asp-controller="Lecturer" asp-action="ViewClaims" class="btn btn-primary">View My Claims</a>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout">
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="SubmitClaim" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" name="LecturerName" value="@ViewBag.LoggedInUser" />
            <div class="mb-3">
                <label class="form-label">Hours Worked</label>
                <input asp-for="HoursWorked" type="number" class="form-control" min="1" max="300" required />
                <span asp-validation-for="HoursWorked" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Supporting Document</label>
                <input type="file" name="document" class="form-control" id="documentInput" />
                <span id="fileNameDisplay" class="text-muted mt-2 d-block"></span>
            </div>

            <script>
                document.getElementById('documentInput').addEventListener('change', function () {
                    const file = this.files[0];
                    const fileDisplay = document.getElementById('fileNameDisplay');
                    if (file) {
                        fileDisplay.textContent = "Selected file: " + file.name;
                    } else {
                        fileDisplay.textContent = "";
                    }
                });
            </script>

            <div class="mb-3">
                <label class="form-label">Additional Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">Submit Claim</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
