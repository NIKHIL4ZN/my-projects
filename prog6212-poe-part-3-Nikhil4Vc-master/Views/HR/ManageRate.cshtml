@model MonthlyClaims_System.Models.ClaimRate
@using Microsoft.AspNetCore.Http
@if (Context.Session.GetString("UserEmail") == null)
{
    <script>
        window.location.href = '/Identity/Account/Login';
    </script>
}


@{
    ViewData["Title"] = "Manage Claim Rate";
}

<!--HR view allows management of rate values-->

<h2>Manage Lecturer Claim Rate</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="post" class="card p-3">

    <label>Hourly Rate (R)</label>
    <input asp-for="HourlyRate" class="form-control" />

    <span asp-validation-for="HourlyRate" class="text-danger"></span>

    <button class="btn btn-primary mt-3">Update Rate</button>

</form>

<a asp-controller="HR" asp-action="HRDashboard" class="btn btn-secondary mt-3">
    Back to Dashboard
</a>