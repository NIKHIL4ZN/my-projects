@model IEnumerable<MonthlyClaims_System.Models.Claim>
@using System.IO
@using Microsoft.AspNetCore.Http
@if (Context.Session.GetString("UserEmail") == null)
{
    <script>
        window.location.href = '/Identity/Account/Login';
    </script>
}

<!--Lecturer view to view claims history-->

@{
    ViewData["Title"] = "My Claims";

    var totalApproved = Model.Where(c => c.Status == "Approved").Sum(c => c.TotalAmount);
    var totalClaims = Model.Count();

    var selectedStatus = Context.Request.Query["status"].ToString();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <div class="btn-group" role="group">
        <a asp-controller="Lecturer" asp-action="SubmitClaim" class="btn btn-primary">Submit New Claim</a>
        <a asp-controller="Lecturer" asp-action="ViewClaims" class="btn btn-primary">View My Claims</a>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout">
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    </div>
</div>

<div class="alert alert-info">
    <strong>Total Claims:</strong> @totalClaims |
    <strong>Approved Amount:</strong> R @totalApproved.ToString("N2")
</div>

<form method="get" asp-action="ViewClaims" class="mb-3">
    <label for="statusFilter" class="form-label">Filter by Status:</label>
    <select id="statusFilter" name="status" onchange="this.form.submit()" class="form-select w-auto d-inline">
        <option value="" selected="@(string.IsNullOrEmpty(selectedStatus))">All</option>
        <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
        <option value="Verified" selected="@(selectedStatus == "Verified")">Verified</option>
        <option value="Approved" selected="@(selectedStatus == "Approved")">Approved</option>
        <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
    </select>
</form>

<a asp-action="DownloadReport"
   class="btn btn-success mb-3">
    Download CSV Report
</a>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        You haven’t submitted any claims yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Claim ID</th>
                <th>Date</th>
                <th>Hours</th>
                <th>Hourly Rate</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Progress</th>
                <th>Document</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model)
            {
                string statusColor = claim.Status switch
                {
                    "Pending" => "bg-warning",
                    "Verified" => "bg-info",
                    "Approved" => "bg-success",
                    "Rejected" => "bg-danger",
                    _ => "bg-secondary"
                };

                int progress = claim.Status switch
                {
                    "Pending" => 25,
                    "Verified" => 50,
                    "Approved" => 100,
                    "Rejected" => 100,
                    _ => 0
                };

                <tr>
                    <td>@claim.ClaimId</td>
                    <td>@claim.ClaimDate.ToShortDateString()</td>
                    <td>@claim.HoursWorked</td>
                    <td>R @claim.HourlyRate.ToString("N2")</td>
                    <td>R @claim.TotalAmount.ToString("N2")</td>
                    <td>
                        <span class="badge @statusColor">@claim.Status</span>
                    </td>
                    <td>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar @statusColor" role="progressbar" style="width:@progress%">
                                @progress%
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(claim.BlobFileName))
                        {
                            <a asp-controller="File"
                               asp-action="Download"
                               asp-route-blobFileName="@claim.BlobFileName"
                               asp-route-originalFileName="@claim.OriginalFileName"
                               class="btn btn-sm btn-outline-primary">
                                Download
                            </a>
                        }
                        else
                        {
                            <span>No file</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
