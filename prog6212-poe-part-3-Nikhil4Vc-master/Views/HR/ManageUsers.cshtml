@model IEnumerable<IdentityUser>
@using Microsoft.AspNetCore.Http
@if (Context.Session.GetString("UserEmail") == null)
{
    <script>
        window.location.href = '/Identity/Account/Login';
    </script>
}

<!--HR view that allows the management of user accounts-->

<h2>Manage Users</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a class="btn btn-primary mb-3" asp-action="CreateUser">Create New User</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    @{
                        var roles = await Context.RequestServices
                        .GetRequiredService<UserManager<IdentityUser>>()
                        .GetRolesAsync(user);

                        <text>@string.Join(", ", roles)</text>
                        ;
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-warning"
                       asp-action="EditUser"
                       asp-route-id="@user.Id">
                        Edit
                    </a>

                    <a class="btn btn-sm btn-danger"
                       asp-action="DeleteUser"
                       asp-route-id="@user.Id"
                       onclick="return confirm('Are you sure you want to delete this user?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-controller="HR" asp-action="HRDashboard" class="btn btn-secondary mt-3">
    Back to Dashboard
</a>

