@model ARCRetailPOE.Models.Order
@{
    ViewData["Title"] = "Place Order";
}

<h2 class="text-center mb-4">Place Your Order</h2>

<form asp-action="Create" method="post" class="card shadow-sm p-4">
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input asp-for="ProductName" class="form-control" placeholder="Enter product name" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" type="number" min="1" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Price (R)</label>
        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" required />
    </div>

    <div class="form-group">
        <input type="submit" value="Submit Order" class="btn btn-primary" />
        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary ms-2">Back</a>
    </div>
</form>
